#!/usr/bin/env expect -f
#
# Scenario for the README's animated demo. It is versioned for a precise
# reason: without it, the demo goes stale at the first interface change and
# nobody knows how to remake it.
#
# It is not run directly but by docs/demo.sh, which prepares the logs, records
# the session and turns it into a GIF.
#
# Why `expect` and not vhs, which the issue had picked: vhs captures its frames
# from the canvas layers of xterm.js, served by ttyd and driven by a headless
# Chrome. With the current versions of ttyd and Chrome it captures nothing at
# all — empty frame directory, no GIF, not one error message. Here there is no
# browser: expect drives a real terminal, asciinema records it, agg makes a GIF
# of it.

# Pause **while reading** the program's output.
#
# This is the delicate point of the whole file. Expect only re-emits what the
# driven program produces at the moment an `expect` command reads it: neither
# `after` (which blocks the event loop) nor `sleep` pump anything. With them,
# the recording ends up with a handful of frames all arriving in the last
# second, instead of some thirty seconds of video.
#
# So we loop on `expect` calls until the deadline. Each returns as soon as a
# byte arrives — the dashboard redraws four times a second, so the wait is
# short — and re-emits it on the way.
proc pause {seconds} {
    set deadline [expr {[clock milliseconds] + int($seconds * 1000)}]
    while {[clock milliseconds] < $deadline} {
        expect -timeout 1 -re {.+} {} timeout {}
    }
}

# `-a` analyses the file from the start before following it: without it, the
# demo would open on empty graphs, refrain settling for the lines written after
# it started — that is `tail -f` behaviour.
spawn refrain -a var/log/prod.log

# --- Overview: volume and errors per second -------------------------------
pause 3.5

# --- Endpoints: what is slow, and how much SQL per request -----------------
send "3"
pause 3.5
# Change the sort: p95 → max. Once only, and deliberately — the selected row
# then stays the slowest endpoint, the very one whose N+1 we are about to show.
# Two more presses (sort by requests) would put an endpoint with no story to
# tell at the top.
send "s"
pause 2.5

# --- Follow the first endpoint across the tabs -----------------------------
send "\r"
pause 2
# Its errors…
send "2"
pause 3
# …and its N+1 patterns, which explain its p95.
send "4"
pause 4
send "\033"
pause 1

# --- Deprecations: one row per deprecation, whatever triggered it ----------
send "5"
pause 3

# --- Search the stream -----------------------------------------------------
send "6"
pause 2
send "/"
pause 0.6
# "exception" in lowercase while the lines carry "Exception": the search
# ignores case, and it shows on screen. Searching for "doctrine" would have
# returned the same line twenty-four times, which shows nothing — the
# exceptions, on the other hand, are all different and coloured.
foreach letter [split "exception" ""] {
    send $letter
    pause 0.12
}
pause 3
send "\033"
pause 1.5

send "q"
expect eof
