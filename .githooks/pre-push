#!/bin/sh
# Refuse any direct push to `main`: on this repository, everything goes through
# a pull request with green CI (CONTRIBUTING.md).
#
# This is a local guard, not a barrier: GitHub cannot protect a branch on a
# private repository under a free account. It catches the absent-minded
# gesture, which is the real risk when working alone. To go around it
# knowingly: `git push --no-verify`.

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "pre-push: direct push to main refused." >&2
            echo "          Open a pull request — see CONTRIBUTING.md." >&2
            echo "          Really necessary? git push --no-verify" >&2
            exit 1
            ;;
    esac
done

exit 0
