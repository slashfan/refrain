#!/bin/sh
# Refuse any direct push to `main`: on this repository, everything goes through
# a pull request with green CI (CONTRIBUTING.md).
#
# The barrier is on the server: `main` carries a protection rule requiring the
# CI checks. This hook enforces nothing more — it just refuses the push before
# it leaves the machine, which is faster than being told off by GitHub, and
# catches the absent-minded gesture where it happens. To go around it
# knowingly: `git push --no-verify`.

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "pre-push: direct push to main refused." >&2
            echo "          Open a pull request — see CONTRIBUTING.md." >&2
            echo "          Really necessary? git push --no-verify" >&2
            exit 1
            ;;
    esac
done

exit 0
